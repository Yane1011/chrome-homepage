{
  "manifest_version": 3,
  "name": "Homepage",
  "short_name": "Homepage",
  "version": "1.0.0",
  "description": "A calm new tab: essentials, folders, search, weather, tasks and notes, synced across your computers.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage", "search", "favicon"],
  "optional_permissions": ["bookmarks"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open a new tab"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
